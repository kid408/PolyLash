[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://scenes/weapons/weapon.gd" id="1_weapon"]
[ext_resource type="PackedScene" path="res://scenes/components/hitbox_component.tscn" id="2_hitbox"]
[ext_resource type="Script" path="res://scenes/weapons/melee/melee_behavior.gd" id="3_behavior"]

[sub_resource type="CircleShape2D" id="1_range_shape"]
radius = 260.0

[node name="WeaponMeleeThrust" type="Node2D"]
script = ExtResource("1_weapon")

[node name="Sprite2D" type="Sprite2D" parent="."]
centered = true

[node name="RangeArea2" type="Area2D" parent="."]
collision_layer = 0
collision_mask = 8

[node name="CollisionShape2D" type="CollisionShape2D" parent="RangeArea2"]
shape = SubResource("1_range_shape")

[node name="HitboxComponent" parent="." instance=ExtResource("2_hitbox")]
collision_layer = 4
collision_mask = 8
monitoring = false
monitorable = false

[node name="CooldownTimer" type="Timer" parent="."]
one_shot = true

[node name="WeaponBehavior" type="Node2D" parent="."]
script = ExtResource("3_behavior")

[connection signal="area_entered" from="RangeArea2" to="." method="_on_range_area_2_area_entered"]
[connection signal="area_exited" from="RangeArea2" to="." method="_on_range_area_2_area_exited"]
[connection signal="timeout" from="CooldownTimer" to="." method="_on_cooldown_timer_timeout"]
