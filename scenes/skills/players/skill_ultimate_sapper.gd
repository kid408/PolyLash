extends SkillUltimate
class_name SkillUltimateSapper

## ==============================================================================
## 工兵大招 - 爆破专家
## ==============================================================================
## 
## 效果：激活期间，所有武器获得爆炸效果
## - 远程武器：子弹命中时产生范围爆炸
## - 近战武器：击中敌人时产生范围爆炸
## 
## 注意：爆炸效果现在由基类 SkillUltimate 提供，所有角色共享
## 
## ==============================================================================

func _on_ultimate_activated() -> void:
	"""大招激活时调用 - 基类已经添加了爆炸效果"""
	# 基类的 _activate() 已经调用了 _apply_explosion_to_weapons()
	# 这里可以添加 Sapper 特有的额外效果（如果需要）
	
	print("[SkillUltimateSapper] 爆破专家模式激活（爆炸效果由基类提供）")
	
	# 显示提示
	if player_ref:
		Global.spawn_floating_text(player_ref.global_position, "爆破模式！", Color(1.0, 0.4, 0.0))

func _on_ultimate_deactivated() -> void:
	"""大招停用时调用 - 基类会自动移除爆炸效果"""
	# 基类的 deactivate() 已经调用了 _remove_explosion_from_weapons()
	# 这里可以移除 Sapper 特有的额外效果（如果有）
	
	print("[SkillUltimateSapper] 爆破专家模式结束")

## ==============================================================================
## 说明
## ==============================================================================
## 
## Sapper 现在使用基类的爆炸效果实现，不需要重复代码。
## 如果需要为 Sapper 添加特殊效果（例如更大的爆炸半径），可以：
## 
## func _ready():
##     super._ready()
##     explosion_radius = 200.0  # 覆盖基类的默认值
## 
## ==============================================================================
