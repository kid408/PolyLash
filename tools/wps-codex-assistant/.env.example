# Service
PORT=8787
BOT_NAME=个人Codex助手
LOG_LEVEL=info

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.3-codex

# Access control
# For a single user, fill in your WPS user id after the app is ready.
ALLOWED_USERS=

# Allowed roots
# Format: alias=absolute_path;alias2=absolute_path2
# Example:
# WORKSPACE_ROOTS=notes=D:\Personal\Notes;inbox=D:\Personal\Inbox
WORKSPACE_ROOTS=workspace=D:\wanglei\PolyLash\docs

# Safety
REQUIRE_CONFIRMATION_FOR_WRITE=true
MAX_HISTORY_TURNS=12
MAX_DIRECTORY_ITEMS=200
MAX_SEARCH_RESULTS=20
MAX_READ_CHARS=20000

# WPS inbound verification
WPS_VERIFY_TOKEN=
WPS_SHARED_SECRET=

# WPS outbound delivery
# none: only return JSON from webhook
# custom_webhook: POST the assistant reply to WPS_REPLY_WEBHOOK_URL
WPS_REPLY_MODE=none
WPS_REPLY_WEBHOOK_URL=
WPS_REPLY_BEARER_TOKEN=
